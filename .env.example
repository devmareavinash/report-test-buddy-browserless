# ---------- Frontend (Vite) ----------
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Local dev: warehouse + playwright-runtime hit local backend (SSO + Browserless OSS).
VITE_LOCAL_FUNCTIONS=run-warehouse-sql,test-warehouse-connectivity,agent-orchestrate,playwright-runtime

# Docker/full self-host only — routes ALL functions to local backend via nginx.
# VITE_USE_LOCAL_BACKEND=true

# ---------- Backend (Deno edge functions) ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Snowflake SSO Python service URL
# Local dev (Python on VDI):  http://127.0.0.1:8002  (not localhost — corp proxy blocks it)
# Docker backend + native SSO: http://host.docker.internal:8002
# Full Docker stack:          http://snowflake-sso:8002
SNOWFLAKE_SSO_URL=http://127.0.0.1:8002
NO_PROXY=127.0.0.1,localhost

# Local Deno backend for orchestrator internal calls (warehouse SSO + workstream children)
LOCAL_FUNCTIONS_URL=http://127.0.0.1:8000/functions/v1

# Optional
LOVABLE_API_KEY=

# Browserless OSS (self-hosted) — required for playwright-runtime
# Local Docker:           http://127.0.0.1:3000  (scripts/dev-browserless.ps1)
# Docker Compose stack:   http://browserless:3000
# GitHub Codespaces:      https://<codespace>-3000.app.github.dev
#   1. Open this repo in Codespaces (devcontainer starts Browserless)
#   2. Ports tab → 3000 → visibility Public
#   3. Set BROWSERLESS_HOST to that HTTPS URL and BROWSERLESS_OSS=true
# Browserless Cloud:      production-sfo.browserless.io  (omit scheme; HTTPS is inferred)
BROWSERLESS_HOST=http://127.0.0.1:3000
BROWSERLESS_TOKEN=local-dev-token
# BROWSERLESS_OSS=true
# BROWSERLESS_USE_HTTPS=false
# BROWSERLESS_CONCURRENT=10
# BROWSERLESS_QUEUED=10
# BROWSERLESS_TIMEOUT_MS=300000
